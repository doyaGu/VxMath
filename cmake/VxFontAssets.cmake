include_guard(GLOBAL)

set(VXMATH_FONT_DIR "" CACHE PATH "Verified Noto font directory; empty downloads to the build cache")
set(_vx_font_manifest "${CMAKE_CURRENT_LIST_DIR}/../fonts/sources.json")
set_property(GLOBAL PROPERTY VXMATH_FONT_MANIFEST "${_vx_font_manifest}")

function(vx_prepare_font_assets output_directory output_files)
    get_property(_manifest GLOBAL PROPERTY VXMATH_FONT_MANIFEST)
    file(READ "${_manifest}" _sources)
    string(JSON _count LENGTH "${_sources}")
    if (VXMATH_FONT_DIR)
        get_filename_component(_directory "${VXMATH_FONT_DIR}" ABSOLUTE)
    else ()
        set(_directory "${CMAKE_BINARY_DIR}/_deps/vxmath-fonts")
    endif ()
    math(EXPR _last "${_count} - 1")
    set(_files)
    foreach (_i RANGE ${_last})
        string(JSON _name MEMBER "${_sources}" ${_i})
        string(JSON _hash GET "${_sources}" "${_name}" sha256)
        set(_file "${_directory}/${_name}")
        if (NOT EXISTS "${_file}" AND NOT VXMATH_FONT_DIR)
            string(JSON _url GET "${_sources}" "${_name}" url)
            file(MAKE_DIRECTORY "${_directory}")
            file(DOWNLOAD "${_url}" "${_file}.download" STATUS _status TLS_VERIFY ON TIMEOUT 120)
            list(GET _status 0 _code)
            if (NOT _code EQUAL 0)
                file(REMOVE "${_file}.download")
                message(FATAL_ERROR "Cannot download ${_name}: ${_status}. Set VXMATH_FONT_DIR for offline builds.")
            endif ()
            file(SHA256 "${_file}.download" _actual)
            if (NOT _actual STREQUAL _hash)
                file(REMOVE "${_file}.download")
                message(FATAL_ERROR "Font checksum mismatch: ${_name}")
            endif ()
            file(RENAME "${_file}.download" "${_file}")
        endif ()
        if (NOT EXISTS "${_file}")
            message(FATAL_ERROR "Missing font asset: ${_file}")
        endif ()
        file(SHA256 "${_file}" _actual)
        if (NOT _actual STREQUAL _hash)
            message(FATAL_ERROR "Font checksum mismatch: ${_file}")
        endif ()
        list(APPEND _files "${_file}")
    endforeach ()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_manifest}" ${_files})
    set(${output_directory} "${_directory}" PARENT_SCOPE)
    set(${output_files} "${_files}" PARENT_SCOPE)
endfunction()
