cmake_minimum_required(VERSION 3.19)

file(MAKE_DIRECTORY "${TEST_ROOT}/source" "${TEST_ROOT}/fonts")
include("${FONT_MODULE}")
set(VXMATH_FONT_DIR "${FONT_SOURCE}")
vx_prepare_font_assets(_directory _files)
file(COPY ${_files} DESTINATION "${TEST_ROOT}/fonts")
file(WRITE "${TEST_ROOT}/fonts/unrelated.txt" "Must not be deployed")
file(WRITE "${TEST_ROOT}/source/CMakeLists.txt" "
cmake_minimum_required(VERSION 3.19)
project(FontAssets NONE)
include(\"${FONT_MODULE}\")
vx_prepare_font_assets(font_directory font_files)
install(FILES \${font_files} DESTINATION Bin/data/fonts COMPONENT Runtime)
")

function(configure_assets expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${TEST_ROOT}/source" -B "${TEST_ROOT}/build"
            "-DVXMATH_FONT_DIR=${TEST_ROOT}/fonts"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
    if (expected STREQUAL "success")
        if (NOT result EQUAL 0)
            message(FATAL_ERROR "Font deployment configuration failed: ${output}")
        endif ()
    elseif (result EQUAL 0 OR NOT output MATCHES "${expected}")
        message(FATAL_ERROR "Font deployment accepted invalid assets: ${output}")
    endif ()
endfunction()

configure_assets(success)
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${TEST_ROOT}/build"
        --prefix "${TEST_ROOT}/install" --component Runtime RESULT_VARIABLE result)
if (NOT result EQUAL 0)
    message(FATAL_ERROR "Font installation failed")
endif ()
foreach (source IN LISTS _files)
    get_filename_component(name "${source}" NAME)
    file(SHA256 "${source}" expected)
    file(SHA256 "${TEST_ROOT}/install/Bin/data/fonts/${name}" actual)
    if (NOT expected STREQUAL actual)
        message(FATAL_ERROR "Installed font or license differs: ${name}")
    endif ()
endforeach ()
if (EXISTS "${TEST_ROOT}/install/Bin/data/fonts/unrelated.txt")
    message(FATAL_ERROR "Unrelated files were included in the font installation")
endif ()
file(WRITE "${TEST_ROOT}/fonts/NotoSans-Regular.ttf" "corrupt font")
configure_assets("Font checksum mismatch")
file(COPY "${FONT_SOURCE}/NotoSans-Regular.ttf" DESTINATION "${TEST_ROOT}/fonts")
file(REMOVE "${TEST_ROOT}/fonts/OFL.txt")
configure_assets("Missing font asset")

# Exercise the downloader with transport failures, without using the network.
file(MAKE_DIRECTORY "${TEST_ROOT}/download-source")
file(WRITE "${TEST_ROOT}/payload.ttf" "verified font fixture")
file(SHA256 "${TEST_ROOT}/payload.ttf" payload_hash)
set(payload_url "file://${TEST_ROOT}/payload.ttf")
if (WIN32)
    set(payload_url "file:///${TEST_ROOT}/payload.ttf")
endif ()
file(WRITE "${TEST_ROOT}/download-manifest.json" "{\"font.ttf\": {\"url\": \"${payload_url}\", \"sha256\": \"${payload_hash}\"}}")
file(WRITE "${TEST_ROOT}/download-source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.19)
project(FontDownload NONE)
include("${FONT_MODULE}")
set_property(GLOBAL PROPERTY VXMATH_FONT_MANIFEST "${TEST_ROOT}/download-manifest.json")
set(download_attempts 0)
macro(file operation)
    if ("${operation}" STREQUAL "DOWNLOAD")
        math(EXPR download_attempts "${download_attempts} + 1")
        _file(WRITE "${CMAKE_BINARY_DIR}/attempts.txt" "${download_attempts}")
        if (download_attempts LESS_EQUAL FAILURES)
            set(download_arguments ${ARGN})
            list(FIND download_arguments STATUS status_index)
            math(EXPR status_index "${status_index} + 1")
            list(GET download_arguments ${status_index} status_variable)
            _file(WRITE "${ARGV2}" "partial download")
            set(${status_variable} 6 "Couldn't resolve host name")
        else ()
            _file(${ARGV})
        endif ()
    else ()
        _file(${ARGV})
    endif ()
endmacro()
vx_prepare_font_assets(font_directory font_files)
]=])

function(check_download name failures expected attempts)
    set(directory "${TEST_ROOT}/download-${name}")
    file(REMOVE_RECURSE "${directory}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${TEST_ROOT}/download-source" -B "${directory}"
            "-DFONT_MODULE=${FONT_MODULE}" "-DTEST_ROOT=${TEST_ROOT}" "-DFAILURES=${failures}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
    if (expected STREQUAL "success")
        if (NOT result EQUAL 0)
            message(FATAL_ERROR "Font download did not recover: ${output}")
        endif ()
        file(SHA256 "${directory}/_deps/vxmath-fonts/font.ttf" actual)
        if (NOT actual STREQUAL payload_hash)
            message(FATAL_ERROR "Downloaded font was not verified")
        endif ()
    elseif (result EQUAL 0 OR NOT output MATCHES "${expected}")
        message(FATAL_ERROR "Font download failed for an unexpected reason: ${output}")
    endif ()
    file(READ "${directory}/attempts.txt" actual_attempts)
    if (NOT actual_attempts EQUAL attempts)
        message(FATAL_ERROR "Unexpected font download attempts: ${actual_attempts}, expected ${attempts}")
    endif ()
    if (EXISTS "${directory}/_deps/vxmath-fonts/font.ttf.download")
        message(FATAL_ERROR "Incomplete font download was retained")
    endif ()
endfunction()

check_download(transient 2 success 3)
check_download(unavailable 99 "Cannot download" 3)
file(WRITE "${TEST_ROOT}/payload.ttf" "corrupt download")
check_download(corrupt 0 "Font checksum mismatch" 1)
